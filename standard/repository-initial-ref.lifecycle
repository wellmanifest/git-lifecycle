# Complementary remote publication profile. The local git-repository profile
# remains unchanged in git-lifecycle.lifecycle.

LIFECYCLE repository-initial-ref VERSION 1
DESCRIPTION "One separately authorized and independently validated first remote ref"
STATE REMOTE_EMPTY INITIAL
STATE INITIAL_REF_PUBLISHED
STATES [ACCEPTED, QUARANTINED] TERMINAL
EVENTS [PUBLISH_INITIAL_REF, VALIDATE_INITIAL_REF, REJECT_INITIAL_REF]
EVIDENCES [DIGEST_BOUND_SINGLE_USE_GRANT, INDEPENDENT_EXACT_HEAD_VALIDATION, INDEPENDENT_REJECTION_EVIDENCE]
TRANSITION REMOTE_EMPTY -> INITIAL_REF_PUBLISHED ON PUBLISH_INITIAL_REF REQUIRES DIGEST_BOUND_SINGLE_USE_GRANT
TRANSITION INITIAL_REF_PUBLISHED -> ACCEPTED ON VALIDATE_INITIAL_REF REQUIRES INDEPENDENT_EXACT_HEAD_VALIDATION
TRANSITION INITIAL_REF_PUBLISHED -> QUARANTINED ON REJECT_INITIAL_REF REQUIRES INDEPENDENT_REJECTION_EVIDENCE
END
