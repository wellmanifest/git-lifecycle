{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wellmanifest/git-lifecycle/standard/workspace-cleanup-policy.schema.json",
  "title": "Wellmanifest multi-criteria workspace cleanup policy and contracts",
  "description": "Closed schemas for deterministic non-LLM workspace cleanup evaluation and bounded LLM-assisted heuristic advice. Documents never grant merge, delete, or lease authority.",
  "oneOf": [
    { "$ref": "#/$defs/snapshotDocument" },
    { "$ref": "#/$defs/reportDocument" },
    { "$ref": "#/$defs/llmAdviceDocument" }
  ],
  "$defs": {
    "rfc3339Utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "worktree_merged",
        "worktree_unmerged",
        "worktree_dirty",
        "build_cache",
        "run_logs",
        "test_artifacts",
        "virtualenv_duplicate",
        "virtualenv_primary",
        "clone_duplicate",
        "bundle_archived_tree",
        "subactor_recovery",
        "unknown"
      ]
    },
    "safetyTier": {
      "type": "string",
      "enum": [
        "T0_SAFE",
        "T1_VERIFY",
        "T2_ARCHIVE_FIRST",
        "T3_PROTECTED"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "DELETE_NOW",
        "PRUNE_GIT_WORKTREE",
        "ARCHIVE_BUNDLE_THEN_DELETE",
        "DEDUPE_KEEP_CANONICAL",
        "QUARANTINE_AND_ASK",
        "HOLD_PROTECTED"
      ]
    },
    "pressureTier": {
      "type": "string",
      "enum": ["normal", "elevated", "critical", "emergency"]
    },
    "leaseState": {
      "type": "string",
      "enum": [
        "none",
        "claimed",
        "editing",
        "validating",
        "publication_frozen",
        "expired",
        "released",
        "foreign"
      ]
    },
    "policyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reclaimWeight",
        "ageWeight",
        "reversibilityWeight",
        "safetyWeight",
        "staleAgeSeconds",
        "reclaimReferenceBytes",
        "maxCandidates"
      ],
      "properties": {
        "reclaimWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "ageWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reversibilityWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "safetyWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
        "staleAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
        "reclaimReferenceBytes": { "type": "integer", "minimum": 1 },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "diskContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeBytes", "totalBytes", "freePercent", "pressureTier"],
      "properties": {
        "freeBytes": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 1 },
        "freePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "pressureTier": { "$ref": "#/$defs/pressureTier" }
      }
    },
    "gitSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isGitTracked",
        "dirtyFilesCount",
        "unpushedCommitsCount",
        "mergedIntoDefault",
        "hasVerifiedBundle",
        "canonicalCopyPath"
      ],
      "properties": {
        "isGitTracked": { "type": "boolean" },
        "dirtyFilesCount": { "type": "integer", "minimum": 0 },
        "unpushedCommitsCount": { "type": "integer", "minimum": 0 },
        "mergedIntoDefault": { "type": "boolean" },
        "hasVerifiedBundle": { "type": "boolean" },
        "canonicalCopyPath": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "leaseSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "owner", "expiresAt"],
      "properties": {
        "state": { "$ref": "#/$defs/leaseState" },
        "owner": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 255
        },
        "expiresAt": {
          "oneOf": [
            { "$ref": "#/$defs/rfc3339Utc" },
            { "type": "null" }
          ]
        }
      }
    },
    "runtimeSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openFileHandles",
        "activeDaemon",
        "activeIdeSession",
        "activeMountOrSymlinkTarget"
      ],
      "properties": {
        "openFileHandles": { "type": "boolean" },
        "activeDaemon": { "type": "boolean" },
        "activeIdeSession": { "type": "boolean" },
        "activeMountOrSymlinkTarget": { "type": "boolean" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "path",
        "artifactKind",
        "sizeBytes",
        "ageSeconds",
        "trackedFilesCount",
        "git",
        "lease",
        "runtime"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "artifactKind": { "$ref": "#/$defs/artifactKind" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "ageSeconds": { "type": "integer", "minimum": 0 },
        "trackedFilesCount": { "type": "integer", "minimum": 0 },
        "git": { "$ref": "#/$defs/gitSignals" },
        "lease": { "$ref": "#/$defs/leaseSignals" },
        "runtime": { "$ref": "#/$defs/runtimeSignals" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "remediation", "evidence"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "veto", "error"]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 512 },
        "evidence": { "type": "object" }
      }
    },
    "criteriaScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reclaimScore",
        "ageScore",
        "reversibilityScore",
        "blastRadiusSafety"
      ],
      "properties": {
        "reclaimScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "ageScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "reversibilityScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "blastRadiusSafety": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "path",
        "artifactKind",
        "safetyTier",
        "verdict",
        "score",
        "vetoReasons",
        "criteriaScores",
        "findings",
        "reclaimableBytes"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "artifactKind": { "$ref": "#/$defs/artifactKind" },
        "safetyTier": { "$ref": "#/$defs/safetyTier" },
        "verdict": { "$ref": "#/$defs/verdict" },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "vetoReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "criteriaScores": { "$ref": "#/$defs/criteriaScores" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "reclaimableBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "llmAdviceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "suggestedVerdict",
        "suggestedTier",
        "confidence",
        "rationale",
        "evidenceRefs",
        "needsHumanDecision"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "suggestedVerdict": { "$ref": "#/$defs/verdict" },
        "suggestedTier": { "$ref": "#/$defs/safetyTier" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 512 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^(snapshot|git|lease|runtime|bundle):[A-Za-z0-9_./:@-]+$"
          }
        },
        "needsHumanDecision": { "type": "boolean" }
      }
    },
    "snapshotDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "repository",
        "observedAt",
        "diskContext",
        "candidates"
      ],
      "properties": {
        "schema": {
          "const": "wellmanifest.git-lifecycle/workspace-cleanup-snapshot/v1"
        },
        "kind": { "const": "workspace-cleanup-snapshot" },
        "repository": { "$ref": "#/$defs/repository" },
        "observedAt": { "$ref": "#/$defs/rfc3339Utc" },
        "policy": { "$ref": "#/$defs/policyConfig" },
        "diskContext": { "$ref": "#/$defs/diskContext" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/candidate" }
        }
      }
    },
    "reportDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "grantsCleanupAuthority",
        "repository",
        "observedAt",
        "diskContext",
        "evaluations",
        "llmBrief"
      ],
      "properties": {
        "schema": {
          "const": "wellmanifest.git-lifecycle/workspace-cleanup-report/v1"
        },
        "kind": { "const": "workspace-cleanup-report" },
        "grantsCleanupAuthority": { "const": false },
        "repository": { "$ref": "#/$defs/repository" },
        "observedAt": { "$ref": "#/$defs/rfc3339Utc" },
        "diskContext": { "$ref": "#/$defs/diskContext" },
        "evaluations": {
          "type": "array",
          "items": { "$ref": "#/$defs/evaluation" }
        },
        "llmBrief": { "type": "object" }
      }
    },
    "llmAdviceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "grantsCleanupAuthority",
        "advisoryOnly",
        "repository",
        "observedAt",
        "modelId",
        "adviceItems"
      ],
      "properties": {
        "schema": {
          "const": "wellmanifest.git-lifecycle/workspace-cleanup-llm-advice/v1"
        },
        "kind": { "const": "workspace-cleanup-llm-advice" },
        "grantsCleanupAuthority": { "const": false },
        "advisoryOnly": { "const": true },
        "repository": { "$ref": "#/$defs/repository" },
        "observedAt": { "$ref": "#/$defs/rfc3339Utc" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adviceItems": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/llmAdviceItem" }
        }
      }
    }
  }
}
