root ::= seed | ticket-branch | local-commit | open-pr | integrate | release | cleanup

seed ::= prefix "seed-baseline\",\"expectedState\":\"uninitialized\",\"targetState\":\"seeded\",\"authorizationRef\":" authorization ",\"seedProfileRef\":" seed-profile suffix
ticket-branch ::= prefix "create-ticket-branch\",\"expectedState\":\"seeded\",\"targetState\":\"ticket-ready\",\"authorizationRef\":" authorization suffix
local-commit ::= prefix "local-commit\",\"expectedState\":\"ticket-ready\",\"targetState\":\"implementation-local\",\"authorizationRef\":" authorization suffix
open-pr ::= prefix "open-pr\",\"expectedState\":\"implementation-local\",\"targetState\":\"review-open\",\"authorizationRef\":" authorization suffix
integrate ::= prefix "integrate\",\"expectedState\":\"review-open\",\"targetState\":\"integrated\",\"authorizationRef\":" authorization suffix
release ::= prefix "release\",\"expectedState\":\"integrated\",\"targetState\":\"released\",\"authorizationRef\":" authorization suffix
cleanup ::= prefix "cleanup\",\"expectedState\":" cleanup-source ",\"targetState\":\"terminal\",\"authorizationRef\":" authorization suffix

prefix ::= "{\"schema\":\"wellmanifest.git-lifecycle/v1\",\"kind\":\"transition-request\",\"requestId\":" request-id ",\"repositoryRef\":" repository ",\"ticket\":" ticket ",\"action\":\""
suffix ::= ",\"evidenceRefs\":" evidence-array ",\"idempotencyKey\":" idempotency "}"
cleanup-source ::= "\"integrated\"" | "\"released\""
request-id ::= "\"request:" safe "\""
repository ::= "\"repository:" safe "\""
ticket ::= "\"ticket-" digit digit digit "\""
authorization ::= "\"authorization:" safe "\""
seed-profile ::= "\"seed-profile:" safe "\""
idempotency ::= "\"idempotency:" safe "\""
evidence-array ::= "[" evidence-list "]"
evidence-list ::= evidence | evidence "," evidence-list
evidence ::= "\"" evidence-kind ":" safe "\""
evidence-kind ::= "artifact" | "receipt" | "decision" | "knowledge"
safe ::= lower safe-tail
safe-tail ::= safe-char safe-tail | ""
safe-char ::= lower | digit | "_" | "." | "-"
lower ::= [a-z]
digit ::= [0-9]
